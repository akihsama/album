# Example environment variables for docker-compose
# 复制成 .env 后填真实值：cp .env.example .env

# REQUIRED
# 用 python scripts/init_password.py 生成，不要手填明文口令
PASSWORD_HASH=
# openssl rand -hex 32
SECRET_KEY=

# Optional
# 与 nginx 的 client_max_body_size 保持一致（默认 50MB）
MAX_CONTENT_LENGTH=52428800
# 反向代理已终结 TLS 时保持 1；本地 http 调试改成 0
BEHIND_TLS=1
# 会话有效期（天）
SESSION_LIFETIME_DAYS=7

# 缩略图：长边像素 / 格式（webp|jpeg|png）/ 质量
# 实测 PNG 原图 → 480px：webp 55KB、jpeg 71KB、png 198KB，3000 张差 3.5 倍体积
THUMB_MAX=480
THUMB_FORMAT=webp
THUMB_QUALITY=82
# 列表每页条数（前端无限滚动）
PAGE_SIZE=60
# 私人云盘：默认必须登录才能上传。要保持旧的匿名上传设成 1
ALLOW_ANONYMOUS_UPLOAD=0

# ---- Cloudflare 命名隧道（scripts/serve_fixed.py 固定域名用，非必填）----
# 只跑局域网 / quick tunnel 的 quick 地址时，下面这些留空或删掉都不影响
# 固定公网地址，两种方式任选其一（推荐第一种，压根不产生 token）：
#   python scripts/serve_fixed.py --init    浏览器登录授权，自己建隧道，填这两项
#   python scripts/serve_fixed.py --setup   手动粘后台的 token，填 TUNNEL_TOKEN
# 两组都配了会直接报错
# TUNNEL_TOKEN=
# TUNNEL_ID=
# TUNNEL_CRED_FILE=
# 你的固定域名，如 album.example.com
# PUBLIC_HOST=
# 隧道名（配置文件名用），默认 album
# TUNNEL_NAME=album
